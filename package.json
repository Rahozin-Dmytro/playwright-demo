{
  "name": "playwright-demo",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test automation with Playwright and TypeScript (saucedemo.com, dummyjson.com), CI with GitHub Actions and Jenkins",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "page-object-model",
    "jenkins",
    "github-actions"
  ],
  "author": "Dmytro Rahozin",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "5.9.3"
  }
}
